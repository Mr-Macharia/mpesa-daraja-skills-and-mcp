# Copy to the repo root as .env (never commit it). Real values only on your own server.

# Daraja app
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# For B2C/B2B/status/balance/reversal:
# DARAJA_INITIATOR_NAME=
# DARAJA_SECURITY_CREDENTIAL=

# Agents send this as "Authorization: Bearer <token>". 32+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DARAJA_MCP_TOKEN=

# Callbacks. DARAJA_DOMAIN is only for the Caddy profile; the base URL is what Safaricom calls.
DARAJA_DOMAIN=mpesa.example.com
DARAJA_CALLBACK_BASE_URL=https://mpesa.example.com
# 16+ random characters; it becomes part of every callback URL.
DARAJA_CALLBACK_TOKEN=

# Hosted mode starts cautious. Uncomment to let agents move money:
# DARAJA_READ_ONLY=false
# Payouts above this many shillings ask for approval in the chat (0 = every payout asks).
# DARAJA_APPROVAL_THRESHOLD=0
# DARAJA_ALLOWED_RECIPIENTS=

# Send every callback on to your app, HMAC-signed (docs/forwarding.md):
# DARAJA_FORWARD_URL=https://shop.example.com/webhooks/mpesa
# DARAJA_FORWARD_SECRET=
