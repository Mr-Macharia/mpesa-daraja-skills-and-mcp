# Easiest: run `uvx mpesa-daraja-mcp setup` instead of editing this by hand.
# Or copy to .env (git-ignored) and fill in from https://developer.safaricom.co.ke/
# Full reference: mcp-server/README.md#configuration

DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# STK Push (sandbox shortcode 174379; passkey from the portal simulator)
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=

# B2C / B2B / status / balance / reversal
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=

# Callbacks (public HTTPS, e.g. an ngrok tunnel in the sandbox)
DARAJA_CALLBACK_BASE_URL=
# Optional built-in receiver:
# DARAJA_CALLBACK_LISTEN=127.0.0.1:8787
# DARAJA_CALLBACK_TOKEN=   # 16+ random characters

# Load only what you need, e.g. stk,c2b
# DARAJA_TOOLSETS=

# Leave unset unless an agent must move live money
# DARAJA_ALLOW_LIVE_MONEY_MOVEMENT=true
