{
  "name": "mpesa-daraja",
  "owner": {
    "name": "mr-macharia"
  },
  "metadata": {
    "description": "Skills and an MCP server for Safaricom's M-Pesa Daraja API",
    "version": "0.1.3"
  },
  "plugins": [
    {
      "name": "mpesa-daraja-skills",
      "description": "M-Pesa Daraja Agent Kit: 15 skills (STK Push, C2B, B2C, B2B, tax, status/balance/reversal, Dynamic QR, Ratiba, Bill Manager, callbacks, security, troubleshooting) plus the mpesa-daraja-mcp server. Sandbox by default.",
      "source": "./",
      "strict": false,
      "version": "0.1.3",
      "skills": [
        "./skills/daraja-account-ops",
        "./skills/daraja-auth",
        "./skills/daraja-b2b",
        "./skills/daraja-b2c",
        "./skills/daraja-bill-manager",
        "./skills/daraja-c2b",
        "./skills/daraja-callbacks",
        "./skills/daraja-credentials-security",
        "./skills/daraja-dynamic-qr",
        "./skills/daraja-ratiba",
        "./skills/daraja-sandbox-setup",
        "./skills/daraja-stk-push",
        "./skills/daraja-tax-remittance",
        "./skills/daraja-troubleshooting",
        "./skills/mpesa-daraja"
      ],
      "mcpServers": {
        "mpesa": {
          "command": "uvx",
          "args": [
            "mpesa-daraja-mcp"
          ]
        }
      }
    }
  ]
}
